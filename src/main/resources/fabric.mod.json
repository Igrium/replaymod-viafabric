{
	"schemaVersion": 1,
	"id": "replaymod-viafabric",
	"version": "${version}",
	"name": "ReplayMod ViaFabricPlus Compat",
	"description": "Makes Replay Mod use ViaFabricPlus for cross-version replay compatibility instead of its own embedded ViaVersion",
	"authors": [
		"Igrium"
	],
	"license": "GPL-3.0",
	"icon": "assets/replaymod-viafabric/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.igrium.replaymod_viafabric.ReplayModViaFabricPlusCompat"
		]
	},
	"mixins": [
		"replaymod-viafabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"replaymod": ">=26.3-2.6.28",
		"viafabricplus": ">=5.1.3"
	}
}